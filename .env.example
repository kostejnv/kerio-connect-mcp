# Copy to .env (never commit .env).

# ---------------------------------------------------------------------------
# Remote server (MCP_TRANSPORT=http) — users sign in with their own Kerio account.
# No Kerio credentials are configured here.
# ---------------------------------------------------------------------------
MCP_TRANSPORT=http
PUBLIC_URL=https://kerio.example.com
PORT=3000
# 32 random bytes, base64: openssl rand -base64 32
# Changing it signs out every connected client.
MCP_TOKEN_KEY=

# Master switch for sending. false (default): nobody can send.
# true: the sign-in page offers an opt-in checkbox per connection (unchecked by default).
KERIO_ALLOW_SEND=false

# Optional: comma-separated Kerio host names users may connect to. Empty = any public https host.
KERIO_ALLOWED_SERVERS=

# ---------------------------------------------------------------------------
# Local use (MCP_TRANSPORT=stdio) — one mailbox.
# ---------------------------------------------------------------------------
# MCP_TRANSPORT=stdio
# KERIO_SERVER=mail.example.com
# KERIO_USERNAME=user@example.com
# KERIO_PASSWORD=
# KERIO_ENABLE_SEND=false

# ---------------------------------------------------------------------------
# Both modes
# ---------------------------------------------------------------------------
# Extra trusted CA (PEM) for company certificates; certificate verification is always on.
# KERIO_CA_FILE=/path/to/company-ca.pem
# Request timeout towards Kerio in milliseconds.
# KERIO_REQUEST_TIMEOUT_MS=30000
# Only for local development against a Kerio server on a private network.
# KERIO_ALLOW_PRIVATE_NETWORK=false
