{
  "name": "kerio-connect-mcp",
  "version": "0.3.0",
  "description": "MCP server for Kerio Connect mail: reliable read-only search and reading, optional sending",
  "author": "aimbit GmbH <info@aimbit.de>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kostejnv/kerio-connect-mcp.git"
  },
  "homepage": "https://github.com/kostejnv/kerio-connect-mcp#readme",
  "bugs": {
    "url": "https://github.com/kostejnv/kerio-connect-mcp/issues"
  },
  "bin": {
    "kerio-connect-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:integration": "npm run build && KERIO_INTEGRATION=1 node --test tests/integration/*.test.mjs",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kerio",
    "kerio-connect",
    "email",
    "mail"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "mammoth": "^1.13.0",
    "undici": "^6.20.1",
    "unpdf": "^1.9.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
